// add256_kernel: c = a + b in fp32. BLOCK = 256 over a work-group of 128 work-items:
// each work-item handles elements base + lid and base + lid + 128 (unrolled, both
// halves stay coalesced). No mask: n is a multiple of 256.
.version 4.2
.kernel "add256_kernel"
.decl R0 v_type=G type=ud num_elts=8 align=wordx32 alias=<%r0, 0>
.decl LID v_type=G type=uw num_elts=32 align=hword
.decl A v_type=G type=uq num_elts=1 align=qword
.decl B v_type=G type=uq num_elts=1 align=qword
.decl C v_type=G type=uq num_elts=1 align=qword
.decl SCR0 v_type=G type=uq num_elts=1 align=qword
.decl SCR1 v_type=G type=uq num_elts=1 align=qword
.decl BASE v_type=G type=ud num_elts=1 align=dword
.decl IDX v_type=G type=ud num_elts=32 align=wordx32
.decl OFF0 v_type=G type=uq num_elts=32 align=wordx32
.decl OFF1 v_type=G type=uq num_elts=32 align=wordx32
.decl ADDR v_type=G type=uq num_elts=32 align=wordx32
.decl XA0 v_type=G type=f num_elts=32 align=wordx32
.decl XB0 v_type=G type=f num_elts=32 align=wordx32
.decl XA1 v_type=G type=f num_elts=32 align=wordx32
.decl XB1 v_type=G type=f num_elts=32 align=wordx32
.input LID offset=64 size=64
.input A offset=128 size=8
.input B offset=136 size=8
.input C offset=144 size=8
.input SCR0 offset=152 size=8
.input SCR1 offset=192 size=8
.kernel_attr Target="3d"
.kernel_attr SimdSize=32
.kernel_attr PerThreadInputSize=64

.function "_main_0"
_main_0:
    shl (M1_NM, 1) BASE(0,0)<1> R0(0,1)<0;1,0> 0x8:ud            // program_id(0) * 256
    add (M1, 32) IDX(0,0)<1> LID(0,0)<1;1,0> BASE(0,0)<0;1,0>
    mov (M1, 32) OFF0(0,0)<1> IDX(0,0)<1;1,0>
    shl (M1, 32) OFF0(0,0)<1> OFF0(0,0)<1;1,0> 0x2:uq            // byte offset, first half
    add (M1, 32) OFF1(0,0)<1> OFF0(0,0)<1;1,0> 0x200:uq           // + 128 elements * 4 bytes
    // issue all four loads before using any of them
    add (M1, 32) ADDR(0,0)<1> OFF0(0,0)<1;1,0> A(0,0)<0;1,0>
    lsc_load.ugm (M1, 32) XA0:d32 flat[ADDR]:a64
    add (M1, 32) ADDR(0,0)<1> OFF0(0,0)<1;1,0> B(0,0)<0;1,0>
    lsc_load.ugm (M1, 32) XB0:d32 flat[ADDR]:a64
    add (M1, 32) ADDR(0,0)<1> OFF1(0,0)<1;1,0> A(0,0)<0;1,0>
    lsc_load.ugm (M1, 32) XA1:d32 flat[ADDR]:a64
    add (M1, 32) ADDR(0,0)<1> OFF1(0,0)<1;1,0> B(0,0)<0;1,0>
    lsc_load.ugm (M1, 32) XB1:d32 flat[ADDR]:a64
    add (M1, 32) XA0(0,0)<1> XA0(0,0)<1;1,0> XB0(0,0)<1;1,0>
    add (M1, 32) XA1(0,0)<1> XA1(0,0)<1;1,0> XB1(0,0)<1;1,0>
    add (M1, 32) ADDR(0,0)<1> OFF0(0,0)<1;1,0> C(0,0)<0;1,0>
    lsc_store.ugm (M1, 32) flat[ADDR]:a64 XA0:d32
    add (M1, 32) ADDR(0,0)<1> OFF1(0,0)<1;1,0> C(0,0)<0;1,0>
    lsc_store.ugm (M1, 32) flat[ADDR]:a64 XA1:d32
    ret (M1, 1)
