// copy_i32_kernel: dst[i] = src[i] for int32.
// BLOCK = 128 = the work-group size (4 sub-groups x 32 lanes): one element per work-item,
// element = program_id(0) * 128 + local_id_x. No mask: n is a multiple of 128.
.version 4.2
.kernel "copy_i32_kernel"
.decl R0 v_type=G type=ud num_elts=8 align=wordx32 alias=<%r0, 0>
.decl LID v_type=G type=uw num_elts=32 align=hword
.decl SRC v_type=G type=uq num_elts=1 align=qword
.decl DST v_type=G type=uq num_elts=1 align=qword
.decl SCR0 v_type=G type=uq num_elts=1 align=qword
.decl SCR1 v_type=G type=uq num_elts=1 align=qword
.decl BASE v_type=G type=ud num_elts=1 align=dword
.decl IDX v_type=G type=ud num_elts=32 align=wordx32
.decl OFF v_type=G type=uq num_elts=32 align=wordx32
.decl ADDR v_type=G type=uq num_elts=32 align=wordx32
.decl V v_type=G type=d num_elts=32 align=wordx32
.input LID offset=64 size=64
.input SRC offset=128 size=8
.input DST offset=136 size=8
.input SCR0 offset=144 size=8
.input SCR1 offset=152 size=8
.kernel_attr Target="3d"
.kernel_attr SimdSize=32
.kernel_attr PerThreadInputSize=64

.function "_main_0"
_main_0:
    shl (M1_NM, 1) BASE(0,0)<1> R0(0,1)<0;1,0> 0x7:ud            // program_id(0) * 128
    add (M1, 32) IDX(0,0)<1> LID(0,0)<1;1,0> BASE(0,0)<0;1,0>    // element index per lane
    mov (M1, 32) OFF(0,0)<1> IDX(0,0)<1;1,0>                     // ud -> uq (zero-extend)
    shl (M1, 32) OFF(0,0)<1> OFF(0,0)<1;1,0> 0x2:uq              // * 4 bytes
    add (M1, 32) ADDR(0,0)<1> OFF(0,0)<1;1,0> SRC(0,0)<0;1,0>
    lsc_load.ugm (M1, 32) V:d32 flat[ADDR]:a64
    add (M1, 32) ADDR(0,0)<1> OFF(0,0)<1;1,0> DST(0,0)<0;1,0>
    lsc_store.ugm (M1, 32) flat[ADDR]:a64 V:d32
    ret (M1, 1)
