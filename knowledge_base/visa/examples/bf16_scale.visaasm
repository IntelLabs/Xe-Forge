// bf16_scale_kernel: y = bf16(2 * f32(x) + 1) for i < n, x and y bf16.
// d16u32 loads one 16-bit value per lane into the low half of a 32-bit slot; a bf alias of
// that register read with stride 2 (<2;1,0>) yields the 32 values, which mov widens to f.
// The result is narrowed with mov into the low halves (destination stride <2>) and stored
// with d16u32, which writes the low 16 bits of each slot.
.version 4.2
.kernel "bf16_scale_kernel"
.decl R0 v_type=G type=ud num_elts=8 align=wordx32 alias=<%r0, 0>
.decl LID v_type=G type=uw num_elts=32 align=hword
.decl X v_type=G type=uq num_elts=1 align=qword
.decl Y v_type=G type=uq num_elts=1 align=qword
.decl SCR0 v_type=G type=uq num_elts=1 align=qword
.decl SCR1 v_type=G type=uq num_elts=1 align=qword
.decl N v_type=G type=d num_elts=1 align=dword
.decl BASE v_type=G type=d num_elts=1 align=dword
.decl IDX v_type=G type=d num_elts=32 align=wordx32
.decl OFF v_type=G type=uq num_elts=32 align=wordx32
.decl ADDR v_type=G type=uq num_elts=32 align=wordx32
.decl RAW v_type=G type=ud num_elts=32 align=wordx32
.decl RAWBF v_type=G type=bf num_elts=64 align=wordx32 alias=<RAW, 0>
.decl F v_type=G type=f num_elts=32 align=wordx32
.decl OUTRAW v_type=G type=ud num_elts=32 align=wordx32
.decl OUTBF v_type=G type=bf num_elts=64 align=wordx32 alias=<OUTRAW, 0>
.decl PM v_type=P num_elts=32
.input LID offset=64 size=64
.input X offset=128 size=8
.input Y offset=136 size=8
.input SCR0 offset=144 size=8
.input SCR1 offset=152 size=8
.input N offset=192 size=4
.kernel_attr Target="3d"
.kernel_attr SimdSize=32
.kernel_attr PerThreadInputSize=64

.function "_main_0"
_main_0:
    shl (M1_NM, 1) BASE(0,0)<1> R0(0,1)<0;1,0> 0x7:ud
    add (M1, 32) IDX(0,0)<1> LID(0,0)<1;1,0> BASE(0,0)<0;1,0>
    cmp.lt (M1, 32) PM IDX(0,0)<1;1,0> N(0,0)<0;1,0>
    mov (M1, 32) OFF(0,0)<1> IDX(0,0)<1;1,0>
    shl (M1, 32) OFF(0,0)<1> OFF(0,0)<1;1,0> 0x1:uq                   // * 2 bytes
    add (M1, 32) ADDR(0,0)<1> OFF(0,0)<1;1,0> X(0,0)<0;1,0>
    (PM) lsc_load.ugm (M1, 32) RAW:d16u32 flat[ADDR]:a64
    mov (M1, 32) F(0,0)<1> RAWBF(0,0)<2;1,0>                          // bf -> f (low halves)
    mad (M1, 32) F(0,0)<1> F(0,0)<1;1,0> 0x40000000:f 0x3f800000:f    // x * 2.0 + 1.0
    mov (M1, 32) OUTBF(0,0)<2> F(0,0)<1;1,0>                          // f -> bf (round to nearest even)
    add (M1, 32) ADDR(0,0)<1> OFF(0,0)<1;1,0> Y(0,0)<0;1,0>
    (PM) lsc_store.ugm (M1, 32) flat[ADDR]:a64 OUTRAW:d16u32
    ret (M1, 1)
