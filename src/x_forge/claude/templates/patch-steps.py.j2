import json, os, sys, torch
from pathlib import Path
from x_forge.frontend import profile
model_id, dump, prompt_file, input_len, trust = sys.argv[1], Path(sys.argv[2]), sys.argv[3], int(sys.argv[4]), sys.argv[5] == "1"
from transformers import AutoModelForCausalLM, AutoTokenizer
tok = AutoTokenizer.from_pretrained(model_id, trust_remote_code=trust)
m = AutoModelForCausalLM.from_pretrained(model_id, dtype=torch.float32, trust_remote_code=trust).eval()
ids = profile.token_ids(profile.hf_vocab(tok), 1, input_len, prompt_file)[0]
index = [json.loads(ln) for ln in open(dump / "index.jsonl") if ln.strip()]
index = [e for e in index if not e.get("call")]  # the first forward: the prompt
mods, outs = dict(m.named_modules()), {}
def keep(name):
    def hook(mod, inp, out):
        out = out if isinstance(out, torch.Tensor) else out[0]  # a tuple or a ModelOutput
        outs[name] = out.detach().float().cpu()
    return hook
names = {e["module"].replace("{i}", str(e["layer"])) for e in index if e.get("module")}
for n in names & set(mods):
    mods[n].register_forward_hook(keep(n))
with torch.no_grad():
    m(input_ids=torch.tensor([ids]), use_cache=False)
rows = []
for e in index:
    row = {k: e.get(k) for k in ("block", "layer", "step", "op", "module")}
    name = (e.get("module") or "").replace("{i}", str(e.get("layer")))
    if not name:
        continue
    if name not in outs:
        rows.append({**row, "error": "no such module in the reference"}); continue
    o = outs[name]
    per_token = o.dim() >= 2 and o.shape[0] == 1 and o.shape[1] == len(ids)  # [1, T, ...]
    ref = o[0].reshape(len(ids), -1) if per_token else o.reshape(1, -1)
    ref = ref[-e["rows"]:] if e["rows"] <= ref.shape[0] else ref
    got = torch.frombuffer(bytearray((dump / e["file"]).read_bytes()), dtype=torch.float32)
    if got.numel() != ref.numel():
        rows.append({**row, "error": f"{got.numel()} values, the reference's {ref.numel()}"}); continue
    ref = ref.reshape(-1)
    rows.append({**row, "rel_err": float((got - ref).norm() / max(float(ref.norm()), 1e-30))})
print(json.dumps(rows))
