# Xe-Forge configuration. Copy to .env at the repository root; a variable set in the shell
# wins over this file, and a command-line flag wins over both. Every variable: docs/REFERENCE.md.

# ---- LLM endpoint (the dspy engines, and the claude / codex agents) ----
# Model, LiteLLM style (provider/model); claude and codex get it without the provider.
LLM_MODEL=openai/gpt-4o
# OpenAI-compatible endpoint URL; claude gets it as ANTHROPIC_BASE_URL.
OPENAI_API_BASE=https://llm.example.com/v1
# API key; claude gets it as ANTHROPIC_AUTH_TOKEN, codex as CODEX_API_KEY.
OPENAI_API_KEY=your-api-key
# Sampling temperature of the dspy engines.
LLM_TEMPERATURE=0.1
# Token limit of one dspy completion.
LLM_MAX_TOKENS=8192

# AWS Bedrock instead: a bedrock/<model-id> model routes there; LiteLLM reads the credentials.
# LLM_MODEL=bedrock/<model-id>
# AWS_BEARER_TOKEN_BEDROCK=your-token
# AWS_REGION_NAME=us-east-1

# ---- Engine (xe-forge) ----
# dspy, claude, codex or dspy-agent.
ENGINE=dspy
# Workspace directory of the claude, codex and dspy-agent engines.
WORKSPACE=./
# Run the claude / codex session headless instead of only generating the workspace.
AUTO_LAUNCH=false
# Turn limit of one headless session.
MAX_TURNS=80
# Trial limit per kernel.
MAX_TRIALS=10
# Trial state directory.
TRIALS_DIR=./trials
# Output comparison against the reference; false is performance only.
REQUIRE_CORRECTNESS=true
# Tolerances used when the spec gives none.
CORRECTNESS_RTOL=1e-2
CORRECTNESS_ATOL=1e-5
# dspy engine: optimizer strategy (cover, react or coordinator) and iterations per stage.
AGENT_STRATEGY=cover
AGENT_MAX_ITERATIONS=5
# dspy engine: load the YAML knowledge base from KNOWLEDGE_DIR.
KNOWLEDGE_BASE_ENABLED=false
KNOWLEDGE_DIR=./knowledge_base
# Pipeline log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ---- Device and DSL ----
# xpu, cuda or cpu.
DEVICE_TYPE=xpu
# triton, gluon, sycl, cuda or opencl.
DSL=triton
# sycl: checkout of sycl-tla whose headers kernels compile against.
# SYCL_TLA_DIR=/path/to/sycl-tla
# sycl: MKL headers; defaults to $MKLROOT/include when oneAPI's environment is loaded.
# MKL_INCLUDE=/path/to/mkl/include

# ---- Profiling ----
# Profile trials with unitrace / VTune.
UNITRACE_ENABLED=false
VTUNE_ENABLED=false
# Binaries, when not on PATH.
UNITRACE_BIN=unitrace
VTUNE_BIN=vtune

# ---- Frontend (xe-forge run / optimize) ----
# Its agents take the LLM endpoint above.
#   XE_FORGE_AGENT=claude              agent CLI of the frontend agents: claude or codex
#   XE_FORGE_CACHE=/path/to/cache      framework venvs and calibrations (default ~/.cache/xe_forge)
#   XE_FORGE_SYCL_FLAGS="..."          compile flags for sycl kernels; {kernel_repo} expands
#   XE_FORGE_AGENT_TIMEOUT=21600       seconds one agent session may run (kernel or frontend)
